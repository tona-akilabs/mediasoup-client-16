{
	"name": "@tona-akilabs/medias-client",
	"version": "1.0.17",
	"description": "mediasoup client side TypeScript library",
	"license": "ISC",
	"homepage": "https://mediasoup.org",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tona-akilabs/mediasoup-client-16.git"
	},
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		},
		"./Transport": {
			"types": "./lib/Transport.d.ts",
			"default": "./lib/Transport.js"
		},
		"./ortc": {
			"types": "./lib/ortc.d.ts",
			"default": "./lib/ortc.js"
		},
		"./enhancedEvents": {
			"types": "./lib/enhancedEvents.d.ts",
			"default": "./lib/enhancedEvents.js"
		},
		"./handlers/FakeHandler": {
			"types": "./lib/handlers/FakeHandler.d.ts",
			"default": "./lib/handlers/FakeHandler.js"
		},
		"./fakeParameters": {
			"types": "./lib/test/fakeParameters.d.ts",
			"default": "./lib/test/fakeParameters.js"
		}
	},
	"files": [
		"LICENSE",
		"README.md",
		"npm-scripts.mjs",
		"lib"
	],
	"engines": {
		"node": ">=16",
		"npm": ">=7"
	},
	"keywords": [
		"webrtc",
		"ortc",
		"browser",
		"nodejs"
	],
	"scripts": {
		"prepare": "node npm-scripts.mjs prepare",
		"typescript:build": "node npm-scripts.mjs typescript:build",
		"typescript:watch": "node npm-scripts.mjs typescript:watch",
		"lint": "node npm-scripts.mjs lint",
		"format": "node npm-scripts.mjs format",
		"test": "node npm-scripts.mjs test",
		"coverage": "node npm-scripts.mjs coverage",
		"release:check": "node npm-scripts.mjs release:check",
		"release": "node npm-scripts.mjs release"
	},
	"dependencies": {
		"@types/events-alias": "npm:@types/events@^3.0.3",
		"awaitqueue": "^2.3.3",
		"debug": "^4.4.3",
		"events-alias": "npm:events@^3.3.0",
		"fake-mediastreamtrack": "^1.0.2",
		"h264-profile-level-id": "^1.1.1",
		"sdp-transform": "^2.15.0",
		"supports-color": "9.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^8.57.1",
		"@types/debug": "^4.1.12",
		"@types/jest": "^29.5.12",
		"@types/node": "^16.14.31",
		"@types/sdp-transform": "^2.15.0",
		"@types/ua-parser-js": "^0.7.39",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-jest": "^27.9.0",
		"eslint-plugin-prettier": "^5.5.4",
		"globals": "^13.24.0",
		"jest": "^29.7.0",
		"open-cli": "^7.2.0",
		"prettier": "^3.6.2",
		"ts-jest": "^29.1.1",
		"typescript": "^5.9.2"
	}
}
