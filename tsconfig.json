{
	"compileOnSave": true,
	"compilerOptions": {
		"target": "ES2020",
		"module": "Node16",
		"outDir": "lib",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"strict": true
	},
	"include": ["src"]
}
